### 5. `PATCH /api/products/:id` - Update Product

**Access:** Admin only

**Request Body:**
```json
{
  "name": "Updated T-Shirt Name",
  "description": "Updated description",
  "isActive": false,
  "categoryId": 2,
  "variants": [
    {
      "id": 1,
      "price": 34.99,
      "stock": 75,
      "sku": "TS-001-S-BLK",
      "isActive": true,
      "discountType": "PERCENTAGE",
      "discountValue": 15,
      "discountStart": "2026-01-01T00:00:00.000Z",
      "discountEnd": "2026-12-31T23:59:59.000Z"
    },
    {
      "sku": "TS-001-M-BLK",
      "price": 29.99,
      "stock": 30,
      "attributes": [
        { "attributeId": 1, "valueId": 2 },
        { "attributeId": 2, "valueId": 5 }
      ]
    }
  ],
  "images": [
    {
      "id": 1,
      "url": "https://example.com/new-image.jpg",
      "altText": "Updated T-Shirt",
      "position": 1
    }
  ]
}
```

**Response (200):**
```json
{
  "message": "Product updated successfully",
  "data": {
    "id": 1,
    "name": "Updated T-Shirt Name",
    "slug": "classic-t-shirt",
    "description": "Updated description",
    "isActive": false,
    "categoryId": 2,
    "createdAt": "2026-02-17T06:00:00.000Z",
    "updatedAt": "2026-02-17T06:15:00.000Z",
    "variants": [
      { "id": 1, "sku": "TS-001-S-BLK", "price": 34.99, "stock": 75, "isActive": true }
    ],
    "images": [
      { "id": 1, "url": "https://example.com/new-image.jpg", "altText": "Updated T-Shirt", "position": 1 }
    ]
  }
}
```

